[Unit]
Description=Durable BotAdmin webhook relay
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/bin/python3 /usr/local/libexec/botadmin-webhook-relay.py
Restart=always
RestartSec=2
User=root
UMask=022
LimitNOFILE=65535

[Install]
WantedBy=multi-user.target
