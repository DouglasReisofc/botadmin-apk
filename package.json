{
  "name": "botadmin",
  "version": "1.0.0",
  "private": false,
  "homepage": "https://botadmin.shop",
  "scripts": {
    "postinstall": "node scripts/patch-yt-search.cjs",
    "clean": "rimraf .next dist/mobile",
    "predev": "npm run clean",
    "dev": "next dev -p 4322",
    "dev:flutter-local": "BOTADMIN_DISABLE_BACKGROUND_JOBS=1 NEXT_TELEMETRY_DISABLED=1 /root/.nvm/versions/node/v20.20.2/bin/node ./node_modules/.bin/next dev -H 0.0.0.0 -p 4310",
    "dev:web-panel": "npm --prefix web_panel run dev",
    "dev:mobile": "NEXT_PUBLIC_CAP_SERVER_URL=http://localhost:4322 next dev -p 4322",
    "dev:mobile:win": "set NEXT_PUBLIC_CAP_SERVER_URL=http://localhost:4322 && next dev -p 4322",
    "build": "npm run build:web",
    "flutter:build:web": "bash scripts/build-flutter-web.sh",
    "flutter:build:apk": "bash scripts/build-flutter-apk.sh",
    "flutter:publish:web": "npm run flutter:build:web && rm -rf public/flutter && mkdir -p public/dashboard/user && rsync -a --delete --exclude='main.dart.v*.js' --exclude='flutter_bootstrap.v*.js' flutter_panel/build/web/ public/dashboard/user/ && test -f public/dashboard/user/canvaskit/canvaskit.wasm && test -f public/dashboard/user/flutter_bootstrap.js && node scripts/version-flutter-web-assets.js && echo 'CanvasKit local OK'",
    "build:android": "npm run mobile:android",
    "build:android:local": "NEXT_PUBLIC_CAP_SERVER_URL=http://localhost:4322 npm run mobile:android",
    "build:android:local:win": "set NEXT_PUBLIC_CAP_SERVER_URL=http://localhost:4322 && npm run mobile:android",
    "web-panel:build": "npm --prefix web_panel run build",
    "web-panel:lint": "npm --prefix web_panel run lint",
    "build:web": "npm run web-panel:build && NODE_OPTIONS=--max-old-space-size=4096 next build --webpack",
    "build:web:light": "nice -n 15 ionice -c3 env NODE_OPTIONS=--max-old-space-size=1024 next build --webpack",
    "build:web:light:turbo": "nice -n 15 ionice -c3 env NODE_OPTIONS=--max-old-space-size=896 next build --turbo",
    "start": "next start -p 4322",
    "lint": "eslint .",
    "mobile:prepare": "tsx scripts/mobile-prepare.ts",
    "mobile:android": "tsx scripts/mobile-build-android.ts",
    "cap:init": "npx cap add android && npx cap add ios",
    "cap:sync": "npm run build:web && npm run mobile:prepare && npx cap sync",
    "cap:android": "npm run cap:sync && npx cap open android",
    "cap:ios": "npm run cap:sync && npx cap open ios",
    "android:wrapper": "bash scripts/install-android-wrapper.sh",
    "predeploy": "npm run build",
    "deploy": "echo 'Deploy requires a Node.js host (e.g. Vercel) to run the dynamic app.'",
    "deploy:bluegreen": "NEXT_DIST_DIR=.next npm run build:web && bash scripts/deploy-blue-green.sh",
    "deploy:bluegreen:current-build": "bash scripts/deploy-blue-green.sh",
    "deploy:bluegreen:status": "bash scripts/deploy-blue-green.sh --status",
    "deploy:bluegreen:rollback": "bash scripts/deploy-blue-green.sh --rollback",
    "meta:profile-photo": "tsx scripts/meta-profile-photo-cli.ts",
    "db:migration:audit": "node scripts/botadmin-db-migration.js --audit",
    "db:migration:plan": "node scripts/botadmin-db-migration.js --plan",
    "db:migration:apply-plans": "node scripts/botadmin-db-migration.js --apply-plan-normalization --apply-base-plan-defaults",
    "db:migration:cleanup": "node scripts/botadmin-db-migration.js --apply-cleanup",
    "db:pg:setup": "tsx scripts/migrate-mysql-to-postgres.ts setup-local-postgres",
    "db:pg:audit": "tsx scripts/migrate-mysql-to-postgres.ts audit",
    "db:pg:schema": "tsx scripts/migrate-mysql-to-postgres.ts schema",
    "db:pg:copy": "tsx scripts/migrate-mysql-to-postgres.ts copy",
    "db:pg:validate": "tsx scripts/migrate-mysql-to-postgres.ts validate",
    "db:pg:final-sync": "tsx scripts/migrate-mysql-to-postgres.ts final-sync",
    "db:pg:cutover-report": "tsx scripts/migrate-mysql-to-postgres.ts cutover-report",
    "uploads:sync-r2": "node scripts/sync-uploads-to-r2.js",
    "test:native-cromite": "tsx scripts/test-native-cromite-api.ts",
    "test:chatgpt-phone-native-flow": "tsx scripts/test-chatgpt-phone-native-flow.ts"
  },
  "dependencies": {
    "@capacitor/android": "^7.4.3",
    "@capacitor/cli": "^7.4.3",
    "@capacitor/core": "^7.4.3",
    "@capacitor/ios": "^7.4.3",
    "@capacitor/push-notifications": "^7.0.3",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@napi-rs/canvas": "^0.1.60",
    "@reduxjs/toolkit": "^2.8.2",
    "@tabler/icons-react": "^3.34.0",
    "@tabler/icons-webfont": "^3.34.0",
    "@tanstack/react-table": "^8.21.3",
    "@tensorflow/tfjs": "^4.22.0",
    "@tippyjs/react": "^4.2.6",
    "@xyflow/react": "^12.10.2",
    "apexcharts": "^4.7.0",
    "axios": "^1.7.7",
    "axios-cookiejar-support": "^4.0.6",
    "bcryptjs": "^2.4.3",
    "bootstrap": "^5.3.7",
    "bootstrap-icons": "^1.13.1",
    "canvacord": "^5.4.10",
    "cheerio": "^0.22.0",
    "eventsource": "^2.0.2",
    "express": "^4.19.2",
    "express-session": "^1.18.1",
    "fast-average-color-node": "^2.0.0",
    "favicons": "^7.2.0",
    "ffmpeg-static": "file:shims/ffmpeg-static",
    "ffprobe-static": "file:shims/ffprobe-static",
    "file-type": "^16.5.4",
    "firebase": "^12.3.0",
    "firebase-admin": "^13.5.0",
    "fluent-ffmpeg": "^2.1.3",
    "form-data": "^4.0.0",
    "jimp": "^0.22.12",
    "knights-canvas": "^1.3.7-a",
    "lottie-web": "^5.13.0",
    "megajs": "^1.3.8",
    "mime-types": "^2.1.35",
    "mysql2": "^3.11.4",
    "next": "^16.1.1",
    "node-cron": "^3.0.3",
    "nodemailer": "^7.0.6",
    "nsfwjs": "^4.1.0",
    "bullmq": "^5.79.0",
    "ioredis": "^5.11.1",
    "playwright": "^1.56.1",
    "pg": "^8.22.0",
    "png-to-ico": "^3.0.1",
    "puppeteer": "^23.11.1",
    "qs": "^6.12.1",
    "quill": "^2.0.3",
    "react": "^19.2.3",
    "react-apexcharts": "^1.7.0",
    "react-bootstrap": "^2.10.10",
    "react-bootstrap-icons": "^1.11.6",
    "react-dom": "^19.2.3",
    "react-dropzone": "^14.3.8",
    "react-feather": "^2.0.10",
    "react-flatpickr": "^4.0.10",
    "react-quilljs": "^2.0.5",
    "react-redux": "^9.2.0",
    "react-responsive": "^10.0.1",
    "redux": "^5.0.1",
    "request": "^2.88.2",
    "sharp": "^0.34.4",
    "simplebar-react": "^3.3.2",
    "socket.io": "^4.8.1",
    "socket.io-client": "^4.8.1",
    "https-proxy-agent": "^7.0.6",
    "socks-proxy-agent": "^8.0.4",
    "swiper": "^11.2.10",
    "tough-cookie": "^4.1.4",
    "twemoji-parser": "^14.0.0",
    "undici": "^6.20.1",
    "uuid": "^11.1.0",
    "wa-sticker-formatter": "^4.4.4",
    "yt-search": "^2.13.1",
    "ytdl-core": "^4.11.5",
    "zod": "^4.4.3",
    "zrapi": "^0.0.6"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@types/bcryptjs": "^2.4.6",
    "@types/fluent-ffmpeg": "^2.1.27",
    "@types/node": "^20",
    "@types/pg": "^8.20.0",
    "@types/quill": "^2.0.14",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "15.3.5",
    "gh-pages": "^6.3.0",
    "gulp-sass": "^6.0.1",
    "rimraf": "^6.0.1",
    "sass": "^1.89.2",
    "sass-loader": "^16.0.5",
    "tsx": "^4.19.2",
    "typescript": "^5",
    "webpack": "^5.99.9"
  },
  "overrides": {
    "canvas": "file:shims/canvas"
  }
}
